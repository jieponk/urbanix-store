# HTTPS otomatis (Let's Encrypt). {$DOMAIN} diisi dari .env server.
{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip

	# Tutup celah header internal Next.js (CVE-2025-29927).
	request_header -x-middleware-subrequest

	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle /media/* {
		root * /srv
		file_server
	}
	handle /admin* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy storefront:3000
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
