+import Link from 'next/link';
+import { money, type Product } from '@/lib/api';
+
+export default function ProductCard({ product }: { product: Product }) {
+  const originalPrice = Number(product.price) || 0;
+  const discountedPrice = Number(product.discount_price) || 0;
+
+  const hasDiscount =
+    discountedPrice > 0 && discountedPrice < originalPrice;
+
+  const finalPrice = hasDiscount ? discountedPrice : originalPrice;
+
+  const discountPercent = hasDiscount
+    ? Math.round(((originalPrice - discountedPrice) / originalPrice) * 100)
+    : 0;
+
+  return (
+    <Link
+      href={`/produk/${product.id}`}
+      className="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-200 hover:-translate-y-1 hover:border-orange-200 hover:shadow-xl hover:shadow-slate-200/60"
+    >
+      <div className="relative aspect-square overflow-hidden bg-[#f7f7f7] p-3 sm:p-5">
+        {product.image_url ? (
+          <img
+            src={product.image_url}
+            alt={product.name}
+            loading="lazy"
+            className="h-full w-full object-contain transition duration-300 group-hover:scale-105"
+          />
+        ) : (
+          <div className="flex h-full items-center justify-center text-center text-xs text-slate-400">
+            Gambar tidak tersedia
+          </div>
+        )}
+
+        {hasDiscount && (
+          <span className="absolute left-2 top-2 rounded-md bg-red-600 px-2 py-1 text-[10px] font-extrabold text-white sm:left-3 sm:top-3">
+            -{discountPercent}%
+          </span>
+        )}
+
+        {product.stock <= 0 && (
+          <span className="absolute inset-x-2 bottom-2 rounded-lg bg-slate-900/85 px-2 py-2 text-center text-[10px] font-bold text-white sm:inset-x-3 sm:bottom-3">
+            Stok habis
+          </span>
+        )}
+      </div>
+
+      <div className="flex flex-1 flex-col p-3 sm:p-4">
+        <p className="truncate text-[10px] font-medium text-slate-500 sm:text-xs">
+          {product.category_name || 'Produk'}
+        </p>
+
+        <h3 className="mt-1 line-clamp-2 min-h-10 text-xs font-bold leading-5 text-slate-800 transition group-hover:text-orange-700 sm:text-sm">
+          {product.name}
+        </h3>
+
+        <div className="mt-3">
+          {hasDiscount && (
+            <p className="text-[10px] text-slate-400 line-through sm:text-xs">
+              {money(originalPrice)}
+            </p>
+          )}
+
+          <p className="break-words text-sm font-extrabold leading-5 tracking-tight text-slate-950 sm:text-base">
+            {money(finalPrice)}
+          </p>
+        </div>
+
+        <div className="mt-auto pt-3">
+          <span
+            className={`block rounded-lg py-2.5 text-center text-[10px] font-bold transition sm:text-xs ${
+              product.stock > 0
+                ? 'bg-orange-50 text-orange-700 group-hover:bg-orange-600 group-hover:text-white'
+                : 'bg-slate-100 text-slate-500'
+            }`}
+          >
+            {product.stock > 0 ? 'Lihat produk →' : 'Lihat detail'}
+          </span>
+        </div>
+      </div>
+    </Link>
+  );
+}
diff --git a/apps/storefront/src/lib/api.ts b/apps/storefront/src/lib/api.ts
new file mode 100644
index 0000000..fe32576
--- /dev/null
+++ b/apps/storefront/src/lib/api.ts
@@ -0,0 +1,98 @@
+export type Product = {
+  id: number;
+  name: string;
+  slug: string;
+  sku: string;
+  category: number;
+  category_name: string;
+  description: string;
+  price: string | number;
+  discount_price: string | number | null;
+  stock: number;
+  image_url: string;
+  is_active: boolean;
+};
+
+export type Category = {
+  id: number;
+  name: string;
+  slug?: string;
+};
+
+type ApiPage<T> = {
+  count: number;
+  next: string | null;
+  previous: string | null;
+  results: T[];
+};
+
+export const API = (
+  process.env.API_URL || 'http://127.0.0.1:8000/api/v1'
+).replace(/\/+$/, '');
+
+export const money = (value: string | number) =>
+  new Intl.NumberFormat('id-ID', {
+    style: 'currency',
+    currency: 'IDR',
+    maximumFractionDigits: 0,
+  }).format(Number(value) || 0);
+
+export async function fetchAll<T>(
+  endpoint: string,
+  init: RequestInit = { cache: 'no-store' }
+): Promise<T[]> {
+  const items: T[] = [];
+  let next: string | null = `${API}/${endpoint}/`;
+  let pageCount = 0;
+
+  while (next && pageCount < 100) {
+    const response = await fetch(next, init);
+
+    if (!response.ok) {
+      throw new Error(`API ${endpoint} gagal: HTTP ${response.status}`);
+    }
+
+    const data: ApiPage<T> | T[] = await response.json();
+
+    if (Array.isArray(data)) {
+      items.push(...data);
+      break;
+    }
+
+    items.push(...data.results);
+    next = data.next;
+    pageCount++;
+  }
+
+  return items;
+}
+
+/** Daftar kategori untuk menu header. Kalau API gagal, menu kategori disembunyikan. */
+export async function getCategories(): Promise<Category[]> {
+  try {
+    return await fetchAll<Category>('categories', {
+      next: { revalidate: 300 },
+    } as RequestInit);
+  } catch {
+    return [];
+  }
+}
+
+/**
+ * Produk untuk beranda: hanya halaman pertama dari API (tidak mengambil
+ * seluruh katalog), lalu dipilih yang aktif, ada stok, dan punya gambar.
+ */
+export async function getFeaturedProducts(limit = 4): Promise<Product[]> {
+  const response = await fetch(`${API}/products/`, { cache: 'no-store' });
+
+  if (!response.ok) {
+    throw new Error(`API products gagal: HTTP ${response.status}`);
+  }
+
+  const data: ApiPage<Product> | Product[] = await response.json();
+  const list = Array.isArray(data) ? data : data.results;
+
+  return list
+    .filter((p) => p.is_active !== false && p.stock > 0 && p.image_url)
+    .slice(0, limit);
+}
