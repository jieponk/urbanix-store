# Salin file ini menjadi apps/backend/.env lalu isi nilainya (file .env tidak ikut ke git).
# Baris yang diawali # diabaikan.

# --- Midtrans (dashboard.midtrans.com -> Settings -> Access Keys) ---
# Selama MIDTRANS_SERVER_KEY belum diisi, opsi "Bayar di web" otomatis disembunyikan.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=False

# Alamat storefront, untuk tombol kembali ke toko setelah bayar di Midtrans.
FRONTEND_URL=http://localhost:3000

# --- Hanya untuk server online (deploy). Biarkan tertutup # saat di PC sendiri. ---
# SECRET_KEY=ganti-dengan-string-acak-panjang
# DEBUG=False
# ALLOWED_HOSTS=api.domainanda.com
