# Salin ke environment server (atau set di PowerShell: $env:NAMA="nilai").
SECRET_KEY=ganti-dengan-string-acak-panjang
DEBUG=False
ALLOWED_HOSTS=api.domainanda.com

# Midtrans (ambil di dashboard.midtrans.com -> Settings -> Access Keys).
# Selama kunci ini belum diisi, opsi "Bayar di web" otomatis disembunyikan.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=False

# Alamat storefront, dipakai untuk tombol kembali setelah bayar di Midtrans.
FRONTEND_URL=http://localhost:3000
